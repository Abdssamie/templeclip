NODE_ENV= # production | development
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PROD_DOMAIN= # trykimu.com

# Cloudflare R2 Storage
R2_ACCOUNT_ID= # Your Cloudflare account ID (or use CLOUDFLARE_ACCOUNT_ID)
R2_ACCESS_KEY_ID= # R2 API token access key
R2_SECRET_ACCESS_KEY= # R2 API token secret key
R2_BUCKET_NAME=kimu-media # R2 bucket name
R2_PUBLIC_URL= # Optional: Custom R2 public domain (e.g., https://bucket.yourdomain.com)

# Remotion Lambda Configuration
REMOTION_AWS_ACCESS_KEY_ID= # AWS access key for Remotion Lambda
REMOTION_AWS_SECRET_ACCESS_KEY= # AWS secret key for Remotion Lambda
REMOTION_AWS_REGION=us-east-1 # AWS region for Lambda deployment
REMOTION_FUNCTION_NAME= # Lambda function name (generated by deploy-lambda-function.ts)
REMOTION_SERVE_URL= # S3 serve URL (generated by deploy-remotion-site.ts)
REMOTION_BUCKET_NAME= # S3 bucket name for renders (generated by deploy-remotion-site.ts)
WEBHOOK_SECRET= # Secret for webhook authentication
API_KEY_SECRET=

# Docker Render Service Configuration
RENDER_SERVER_PORT=8080
RENDER_SERVER_URL=http://localhost:8080  # Internal URL for render service
ENABLE_DOCKER_RENDER=false  # Set to true to use Docker rendering instead of Lambda
REDIS_URL=redis://localhost:6379  # Redis URL for BullMQ job queue 