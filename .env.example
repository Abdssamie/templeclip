NODE_ENV= # production | development
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PROD_DOMAIN= # trykimu.com

# Cloudflare R2 Storage
R2_ACCOUNT_ID= # Your Cloudflare account ID (or use CLOUDFLARE_ACCOUNT_ID)
R2_ACCESS_KEY_ID= # R2 API token access key
R2_SECRET_ACCESS_KEY= # R2 API token secret key
R2_BUCKET_NAME=kimu-media # R2 bucket name
R2_PUBLIC_URL= # Optional: Custom R2 public domain (e.g., https://bucket.yourdomain.com)

WEBHOOK_SECRET= # Secret for webhook authentication
API_KEY_SECRET=

# Docker Render Service Configuration
RENDER_SERVER_PORT=8080
RENDER_SERVER_URL=http://localhost:8080  # Internal URL for render service
REDIS_URL=redis://localhost:6379  # Redis URL for BullMQ job queue


# Render Service Security
RENDER_API_TOKEN=
